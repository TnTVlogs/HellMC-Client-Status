{
  "name": "hellmc-status",
  "version": "0.1.0",
  "private": true,
  "description": "Pàgina d'estat pública i autònoma de HellMC: monitoratge automàtic, historial i incidències.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p .",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
