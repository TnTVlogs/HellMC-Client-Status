# Còpia a .env i omple els valors. Veure README.md.

PORT=4100
HOST=127.0.0.1

# Carpeta de l'històric (status.json). Feu-ne còpia de seguretat si no voleu perdre l'historial.
DATA_DIR=./data

# Components fixos (servei, distribució...). Còpia components.example.json a components.json.
COMPONENTS_FILE=./components.json

# Token amb què el panell gestiona incidències i servidors. Genera'l amb: openssl rand -hex 32
# El MATEIX valor ha d'anar al backend del panell (STATUS_API_TOKEN).
API_TOKEN=

# Proxies de confiança davant el servei (Apache = 1, Cloudflare + Apache = 2). 0 en local.
TRUST_PROXY_HOPS=0

SITE_TITLE=HellMC Estat
SITE_SUBTITLE=Estat dels serveis de HellMC

# Comprovacions (valors per defecte)
# DEFAULT_INTERVAL_SECONDS=60
# DEFAULT_TIMEOUT_MS=8000
# DEFAULT_SLOW_MS=2500
# FAIL_THRESHOLD=3
# DEGRADED_THRESHOLD=3
# RECOVER_THRESHOLD=2
# RETENTION_DAYS=90
